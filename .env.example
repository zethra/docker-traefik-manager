# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=traefik
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=traefik_manager

# ── App ───────────────────────────────────────────────────────────
# Generate via: openssl rand -base64 32
AUTH_SECRET=change-me-32-bytes-base64
AUTH_URL=https://manager.example.com

# Bearer token Traefik sends to the HTTP provider endpoint
TRAEFIK_PROVIDER_TOKEN=change-me-traefik-token

# Comma-separated. Every name listed here must also be declared
# in docker-compose.yml as TRAEFIK_CERTIFICATESRESOLVERS_<NAME>_...
TRAEFIK_CERT_RESOLVERS=technitium

# Seeded on first boot. After login, change the password via the UI.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# ── Traefik ───────────────────────────────────────────────────────
ACME_EMAIL=admin@example.com
MANAGER_HOST=manager.example.com
MANAGER_DOMAIN=example.com

# ── Technitium / RFC2136 DNS-01 ───────────────────────────────────
# Your Technitium server, e.g. 192.168.1.1:53 — must speak RFC2136
RFC2136_NAMESERVER=ns.example.com:53
RFC2136_TSIG_KEY=traefik-key.
RFC2136_TSIG_SECRET=base64-encoded-secret
RFC2136_TSIG_ALGORITHM=hmac-sha256.
